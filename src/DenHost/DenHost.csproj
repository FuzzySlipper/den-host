<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>den-host</AssemblyName>
    <RootNamespace>DenHost</RootNamespace>
    <OutputType>Exe</OutputType>
    <!--
      den-host is a Web SDK app that exposes:
      - A FleetOps HTTP API on a configurable port (default :5400)
      - CLI surface for one-shot operations (health, binding, events, etc.)
      - Background services for adapter heartbeat and Channels event reading
    -->
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\DenHost.Harness\DenHost.Harness.csproj" />
    <!--
      The Hermes module assembly is referenced because #1917 wires it as the
      first concrete harness module. The factory in AddDenHost is the only
      DenHost code that names HermesHarnessModule; everything else uses
      IHarnessModule. Future modules (Pi/Codex/Claude Code/OpenCode) will
      follow the same pattern: their own assembly, referenced here.
    -->
    <ProjectReference Include="..\DenHost.Harness.Modules.Hermes\DenHost.Harness.Modules.Hermes.csproj" />
  </ItemGroup>

</Project>
