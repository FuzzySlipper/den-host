<Project>
  <PropertyGroup>
    <!-- Work around Arch/.NET 10 SDK installations that omit prune package data for Microsoft.AspNetCore.App. -->
    <AllowMissingPrunePackageData>true</AllowMissingPrunePackageData>

    <!-- Common conventions for all den-host projects. -->
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningsNotAsErrors>CS1591</WarningsNotAsErrors> <!-- missing XML doc; we'll document public surface selectively -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <Company>den-host</Company>
    <Product>den-host</Product>
    <Authors>den-host-agent</Authors>
    <Copyright>Copyright (c) den-host contributors</Copyright>
    <NeutralLanguage>en-US</NeutralLanguage>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
  </PropertyGroup>
</Project>
